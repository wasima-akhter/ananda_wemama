	<string>We need your location to show nearby services and enable delivery.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>We need your location even when the app is in background to provide real-time updates.</string>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wemama</string>
			</array>
		</dict>
	</array>

